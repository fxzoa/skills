services:
  crawl4ai:
    image: unclecode/crawl4ai:latest
    container_name: crawl4ai
    restart: unless-stopped
    ports:
      - "${CRAWL4AI_PORT:-11235}:11235"
    shm_size: 1g
    environment:
      - CRAWL4AI_API_TOKEN=${CRAWL4AI_API_TOKEN}
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://127.0.0.1:11235/health || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
