# ==============================================================================
# Cloud Run All-in-One Deployment Environment Variables (.env.cloudrun.example)
# ==============================================================================

# --- Cloud Run 基本設定 ---
PORT=8080
HOST=0.0.0.0
DB_PATH=/app/data/tracker.db

# --- Redis 接続設定 ---
# GCP Memorystore またはローカル Redis URL を指定
REDIS_URL=redis://127.0.0.1:6379

# --- SSH トンネル（リモート Redis 利用時のみ） ---
ENABLE_REDIS_TUNNEL=false
SSH_TARGET=user@remote-server-ip
SSH_PORT=22
REMOTE_REDIS_PORT=6379
LOCAL_REDIS_PORT=6379
# Secret Manager 等から注入する場合:
# SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n..."

# --- サブコンポーネント有効化トグル (true/false) ---
# 個別に不要なボットやWebUIを停止してリソースを節約できます
ENABLE_TOP20=true
ENABLE_TOP20_WORKER=true
ENABLE_PRICE_MONITOR=true
ENABLE_PRICE_MONITOR_WORKER=true
ENABLE_BTC_DCA=true
ENABLE_BTC_DCA_BOT=true
ENABLE_BTC_GRID=true
ENABLE_BTC_GRID_BOT=true
ENABLE_SURGE_DIP=true
ENABLE_SURGE_DIP_BOT=true
ENABLE_MULTI_DCA=true
ENABLE_MULTI_DCA_BOT=true
ENABLE_SLACK_ALERT=true
ENABLE_SLACK_ALERT_SENDER=true
ENABLE_COIN_TRADE=true

# --- 各種外部サービス API キー / 認証情報 ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# HYPERLIQUID_WALLET_ADDRESS=0x...
# HYPERLIQUID_PRIVATE_KEY=0x...
