FROM denoland/deno:alpine-2.9.5

WORKDIR /app

# OpenSSH クライアント（Redis SSH トンネル用）と netcat のインストール
RUN apk add --no-cache openssh-client netcat-openbsd

ENV DENO_DIR=/app/.cache/deno
ENV PORT=8080
ENV HOST=0.0.0.0
ENV DB_PATH=/app/data/tracker.db

# 依存関係定義と全ソースコード
COPY deno.json ./
COPY src/ ./src/

# Cloud Run 統合エントリーポイントスクリプトの配置
COPY deploy/cloudrun/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# 依存関係の事前キャッシュ
RUN mkdir -p /app/data /app/.cache/deno /ssh && \
    deno cache --allow-import src/dashboard_webui/server.ts && \
    deno cache --allow-import src/coin_trade_webui/webui/main.ts && \
    chown -R deno:deno /app /ssh

EXPOSE 8080

ENTRYPOINT ["/app/entrypoint.sh"]
